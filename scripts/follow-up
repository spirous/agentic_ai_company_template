#!/bin/zsh
# follow-up — Draft a follow-up email for a contact from their CI page.
#
# Usage:
#   follow-up "Acme Corp"                              # cloud (default)
#   follow-up "Acme Corp" --local                      # local Ollama
#   follow-up "Acme Corp" --context "sent proposal last week"
#   follow-up "Acme Corp" --local --model phi4:latest
#
# Cloud path: fetches CI page → passes to Claude Code with contact_agent rules
# Local path: fetches CI page → drafts email via Ollama (no external API call)

set -e

PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# Load defaults from .env
if [[ -f "$PROJECT_DIR/.env" ]]; then
  set -a
  source "$PROJECT_DIR/.env"
  set +a
fi

USE_LOCAL=false
LOCAL_MODEL="phi4:latest"
COMPANY=""
CONTEXT=""
SPACE="${CONFLUENCE_SPACE:-YOUR_SPACE_KEY}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --local)   USE_LOCAL=true; shift ;;
    --model)   LOCAL_MODEL="$2"; shift 2 ;;
    --context) CONTEXT="$2"; shift 2 ;;
    --space)   SPACE="$2"; shift 2 ;;
    --help|-h)
      echo "Usage: follow-up \"Company\" [--local] [--model MODEL] [--context \"...\"]"
      exit 0 ;;
    -*)
      echo "❌ Unknown option: $1"; exit 1 ;;
    *)
      COMPANY="$1"; shift ;;
  esac
done

if [[ -z "$COMPANY" ]]; then
  echo "Usage: follow-up \"Company\" [--local] [--context \"...\"]"
  exit 1
fi

if $USE_LOCAL; then
  PIPELINE_ARGS=("$COMPANY" --model "$LOCAL_MODEL" --space "$SPACE")
  [[ -n "$CONTEXT" ]] && PIPELINE_ARGS+=(--context "$CONTEXT")
  python3 "$PROJECT_DIR/scripts/contact_pipeline.py" "${PIPELINE_ARGS[@]}"
else
  echo "🔍 Fetching Contact Intelligence page for '$COMPANY'..."
  PIPELINE_ARGS=("$COMPANY" --fetch-only --space "$SPACE")
  [[ -n "$CONTEXT" ]] && PIPELINE_ARGS+=(--context "$CONTEXT")
  CI_PROMPT=$(python3 "$PROJECT_DIR/scripts/contact_pipeline.py" "${PIPELINE_ARGS[@]}")

  if [[ -z "$CI_PROMPT" ]]; then
    echo "❌ Could not fetch CI page. Run: new-contact \"$COMPANY\" \"<Parent Page Title>\""
    exit 1
  fi

  cd "$PROJECT_DIR"
  unset ANTHROPIC_AUTH_TOKEN; unset ANTHROPIC_BASE_URL
  claude --dangerously-skip-permissions -p "$CI_PROMPT"
fi
